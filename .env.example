# Anthropic (the agent's model)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# PayPal sandbox only. Never put live credentials here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PORT=4310

# Where PayPal sends the buyer back to. Use your real https URL when hosted.
PUBLIC_BASE_URL=http://localhost:4310
