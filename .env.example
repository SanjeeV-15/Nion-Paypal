# Anthropic (the agent's model)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# PayPal sandbox only. Never put live credentials here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PORT=4310

# Where PayPal sends the buyer back to. Use your real https URL when hosted.
PUBLIC_BASE_URL=http://localhost:4310

# Caps on AI calls, so a public demo cannot run up a bill.
NION_MAX_AI_PER_HOUR=40
NION_MAX_AI_PER_DAY=500

# Optional: a saved sandbox wallet any visitor can use without signing in to PayPal.
# Get the id with: npm run smoke:paypal -- vault
# DEMO_WALLET_VAULT_ID=
# DEMO_WALLET_LABEL=shared demo buyer (sandbox)
